# Скопируйте в .env при необходимости: cp .env.example .env
# Токены и API key не нужны: модель работает в локальном Ollama (ollama serve).

# Адрес локального сервера Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Модель Ollama с поддержкой tool calling. Если установлена только qwen3:4b — укажите её.
OLLAMA_MODEL=qwen3:8b

# Максимальное время ожидания ответа локальной модели, миллисекунды.
OLLAMA_TIMEOUT_MS=120000

# Порт локального API задач.
API_PORT=3000

# Базовый URL локального API, к которому обращаются LangChain tools.
API_BASE_URL=http://127.0.0.1:3000
