# Optional settings for the dev-helper MCP server. None of them is a secret.
# Copy to .env (git-ignored) to override locally, or pass them via the MCP client config.
# Relative paths are resolved against the HW-4 directory.

# Directory that search_code, get_file_outline and run_check may access.
PROJECT_ROOT=demo-project
# Markdown knowledge base for lookup_docs.
DOCS_ROOT=docs-kb
# Also append JSON-line logs to this file (stderr is always used). Empty = stderr only.
LOG_FILE=logs/mcp-server.log
# Timeout for run_check, 1000..300000 ms.
CHECK_TIMEOUT_MS=60000
